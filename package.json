{
  "name": "app-book-medicina-aeroespacial",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.16",
    "expo-asset": "^58.0.17",
    "expo-constants": "~58.0.12",
    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.9",
    "expo-image": "~58.0.16",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-local-authentication": "~58.0.2",
    "expo-router": "~58.0.24",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-video": "~58.0.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export -p web",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "auditar:midias": "tsx --require ./scripts/stub-assets.cjs scripts/auditar-midias.ts",
    "traduzir": "node scripts/traduzir.cjs",
    "build:android:teste": "npx eas-cli@latest build -p android --profile preview",
    "build:android": "npx eas-cli@latest build -p android --profile production",
    "enviar:android": "npx eas-cli@latest submit -p android --profile production",
    "check:publicacao": "node scripts/check-publicacao.cjs",
    "build:ios:teste": "npx eas-cli@latest build -p ios --profile preview",
    "build:ios": "npx eas-cli@latest build -p ios --profile production",
    "enviar:ios": "npx eas-cli@latest submit -p ios --profile production",
    "build:todos": "npx eas-cli@latest build -p all --profile production",
    "loja:ficha": "tsx --require ./scripts/stub-assets.cjs scripts/gerar-loja.ts"
  },
  "private": true
}
